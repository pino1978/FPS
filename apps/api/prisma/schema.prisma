generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PredictionRun {
  id           String               @id @default(cuid())
  fixtureId    String
  modelVersion String
  source       String
  asOf         DateTime             @default(now())
  eventAt      DateTime
  snapshots    PredictionSnapshot[]

  @@index([fixtureId, eventAt])
}

model PredictionSnapshot {
  id            String        @id @default(cuid())
  runId         String
  run           PredictionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  market        String
  selection     String
  probability   Float
  confidence    Float
  dataQuality   Float
  status        String
  outcome       String?
  settledAt     DateTime?
  resultVersion String?
  createdAt     DateTime      @default(now())

  @@index([status, outcome])
}

model Bet {
  id            String    @id @default(cuid())
  fixtureId     String
  market        String
  selection     String
  stake         Float
  odds          Float?
  played        Boolean   @default(false)
  status        String    @default("PENDING")
  eventAt       DateTime
  createdAt     DateTime  @default(now())
  verifiedAt    DateTime?
  resultVersion String?

  @@index([played, status, eventAt])
}

model BettingSystem {
  id           String              @id @default(cuid())
  mode         String
  profile      String?
  budget       Float
  totalCost    Float
  played       Boolean             @default(false)
  status       String              @default("PENDING")
  createdAt    DateTime            @default(now())
  selections   SystemSelection[]
  combinations SystemCombination[]
}

model SystemSelection {
  id               String            @id @default(cuid())
  systemId         String
  system           BettingSystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  clientKey        String
  fixtureId        String
  market           String
  selection        String
  eventAt          DateTime
  odds             Float?
  status           String            @default("PENDING")
  verifiedAt       DateTime?
  resultVersion    String?
  combinationItems CombinationItem[]

  @@unique([systemId, clientKey])
  @@index([status, eventAt])
}

model SystemCombination {
  id        String            @id @default(cuid())
  systemId  String
  system    BettingSystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  stake     Float
  status    String            @default("PENDING")
  items     CombinationItem[]
  createdAt DateTime          @default(now())

  @@index([systemId, status])
}

model CombinationItem {
  id            String            @id @default(cuid())
  combinationId String
  combination   SystemCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  selectionId   String
  selection     SystemSelection   @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([combinationId, selectionId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  payload    Json?
  createdAt  DateTime @default(now())
}
