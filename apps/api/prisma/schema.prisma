generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Fixture {
  id             String   @id
  competition    String
  status         String
  utcDate        DateTime
  homeTeamId     String
  homeTeam       String
  awayTeamId     String
  awayTeam       String
  source         String
  homeScore      Int?
  awayScore      Int?
  resultVerified Boolean  @default(false)
  verifiedAt     DateTime?
  resultVersion  String?
  resultEvidence Json?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([competition, utcDate])
  @@index([status, utcDate])
  @@index([resultVerified, utcDate])
}

model TeamSnapshot {
  id               String   @id @default(cuid())
  competition      String
  teamId           String
  capturedAt       DateTime @default(now())
  played           Int
  points           Int
  goalsFor         Int
  goalsAgainst     Int
  formIndex        Float?
  homePlayed       Int?
  homePoints       Int?
  homeGoalsFor     Int?
  homeGoalsAgainst Int?
  awayPlayed       Int?
  awayPoints       Int?
  awayGoalsFor     Int?
  awayGoalsAgainst Int?
  source           String

  @@index([competition, teamId, capturedAt])
}

model PredictionRun {
  id            String               @id @default(cuid())
  fixtureId     String
  modelVersion  String
  source        String
  asOf          DateTime             @default(now())
  eventAt       DateTime
  inputSnapshot Json?
  snapshots     PredictionSnapshot[]

  @@index([fixtureId, eventAt])
  @@index([modelVersion, asOf])
}

model PredictionSnapshot {
  id            String                @id @default(cuid())
  runId         String
  run           PredictionRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  market        String
  selection     String
  probability   Float
  confidence    Float
  dataQuality   Float
  fairOdds      Float?
  valueStatus   String                @default("UNAVAILABLE")
  offeredOdds   Float?
  expectedValue Float?
  status        String
  reason        String?
  createdAt     DateTime              @default(now())
  settlement    PredictionSettlement?
  /// Legacy compatibility only. V2 settlement never writes these fields.
  outcome       String?
  settledAt     DateTime?
  resultVersion String?

  @@index([status, createdAt])
  @@index([market, createdAt])
}

model PredictionSettlement {
  id            String             @id @default(cuid())
  snapshotId    String             @unique
  snapshot      PredictionSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  outcome       String
  settledAt     DateTime           @default(now())
  resultVersion String
  evidence      Json?

  @@index([outcome, settledAt])
}

model OddsSnapshot {
  id                String   @id @default(cuid())
  fingerprint       String   @unique
  fixtureId         String
  providerFixtureId String?
  bookmaker         String
  market            String
  selection         String
  odds              Float
  capturedAt        DateTime @default(now())
  providerUpdatedAt DateTime?
  source            String

  @@index([fixtureId, market, capturedAt])
  @@index([bookmaker, market, capturedAt])
}

model Bet {
  id                 String    @id @default(cuid())
  fixtureId          String
  competition        String?
  market             String
  selection          String
  stake              Float
  odds               Float?
  bookmaker          String?
  notes              String?
  played             Boolean   @default(false)
  simulated          Boolean   @default(false)
  playedAt           DateTime?
  status             String    @default("PENDING")
  verificationStatus String    @default("PENDING")
  eventAt            DateTime
  createdAt          DateTime  @default(now())
  verifiedAt         DateTime?
  resultVersion      String?
  originProbability  Float?
  originConfidence   Float?
  originDataQuality  Float?
  originFairOdds     Float?
  originModelVersion String?
  originCapturedAt   DateTime?

  @@index([played, verificationStatus, eventAt])
  @@index([simulated, verificationStatus, eventAt])
  @@index([competition, market, createdAt])
}

model BettingSystem {
  id                 String              @id @default(cuid())
  mode               String
  profile            String?
  budget             Float
  totalCost          Float
  bookmaker          String?
  notes              String?
  played             Boolean             @default(false)
  simulated          Boolean             @default(false)
  playedAt           DateTime?
  status             String              @default("PENDING")
  verificationStatus String              @default("PENDING")
  createdAt          DateTime            @default(now())
  selections         SystemSelection[]
  combinations       SystemCombination[]
}

model SystemSelection {
  id                 String            @id @default(cuid())
  systemId           String
  system             BettingSystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  clientKey          String
  fixtureId          String
  competition        String?
  market             String
  selection          String
  eventAt            DateTime
  odds               Float?
  originProbability  Float?
  originConfidence   Float?
  originDataQuality  Float?
  originFairOdds     Float?
  originModelVersion String?
  originCapturedAt   DateTime?
  status             String            @default("PENDING")
  verificationStatus String            @default("PENDING")
  verifiedAt         DateTime?
  resultVersion      String?
  combinationItems   CombinationItem[]

  @@unique([systemId, clientKey])
  @@index([verificationStatus, eventAt])
}

model SystemCombination {
  id        String            @id @default(cuid())
  systemId  String
  system    BettingSystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  stake     Float
  status    String            @default("PENDING")
  items     CombinationItem[]
  createdAt DateTime          @default(now())

  @@index([systemId, status])
}

model CombinationItem {
  id            String            @id @default(cuid())
  combinationId String
  combination   SystemCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  selectionId   String
  selection     SystemSelection   @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([combinationId, selectionId])
}

model BacktestRun {
  id           String   @id @default(cuid())
  competition  String
  modelVersion String
  fromDate     DateTime
  toDate       DateTime
  status       String   @default("COMPLETED")
  sample       Int
  brierScore   Float?
  hitRate      Float?
  createdAt    DateTime @default(now())
  parameters   Json?

  @@index([competition, modelVersion, createdAt])
}

model PaperTradingRun {
  id              String   @id @default(cuid())
  bankrollInitial Float
  bankrollFinal   Float
  stakeTotal      Float
  returnsTotal    Float
  profit          Float
  roi             Float?
  yieldValue      Float?
  winRate         Float?
  maxDrawdown     Float?
  betsCount       Int
  systemsCount    Int      @default(0)
  createdAt       DateTime @default(now())
  parameters      Json?
}

model AuditEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}
